[
 {
  "op": "add",
  "path": "/properties/Domain/minLength",
  "value": 1
 },
 {
  "op": "add",
  "path": "/properties/Domain/maxLength",
  "value": 63
 },
 {
  "op": "add",
  "path": "/allOf",
  "value": [
   {
    "if": {
     "required": [
      "CustomDomainConfig"
     ]
    },
    "then": {
     "properties": {
      "Domain": {
       "pattern": "^[a-z0-9](?:[a-z0-9\\-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9\\-]*[a-z0-9])?)+$"
      }
     }
    }
   },
   {
    "if": {
     "not": {
      "required": [
       "CustomDomainConfig"
      ]
     }
    },
    "then": {
     "properties": {
      "Domain": {
       "pattern": "^[a-z0-9](?:[a-z0-9\\-]{0,61}[a-z0-9])?$"
      }
     }
    }
   }
  ]
 }
]
